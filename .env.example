# AutoXP – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Runtime environment ───────────────────────────────────────────────────────
# Set to "production" when deploying. Controls JWT secret enforcement & logging.
ENVIRONMENT=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=
AUTOXP_DB=autoxp

# ── JWT (must be 32+ random characters in production) ────────────────────────
JWT_SECRET=

# ── CORS (comma-separated list of allowed frontend origins) ──────────────────
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173

# ── Frontend (set to full backend URL when frontend is separately hosted) ─────
# Leave empty or /api when served from the same origin.
VITE_API_BASE_URL=

# ── Legacy / unused – kept for reference ─────────────────────────────────────
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# S3_BUCKET=listing-images

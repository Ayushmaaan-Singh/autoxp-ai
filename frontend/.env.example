# AutoXP Frontend – Environment Variables
# Copy to frontend/.env (or .env.local) and fill in values.
# NEVER commit .env / .env.local to version control.

# Full URL of the backend API for production deployments.
# Example: https://api.autoxp.yourdomain.com/api
# Leave empty (or /api) when the frontend and backend are on the same origin.
VITE_API_BASE_URL=

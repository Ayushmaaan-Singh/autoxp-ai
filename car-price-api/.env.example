# AutoXP Backend – Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.

# Runtime environment: "development" or "production"
# In production, JWT_SECRET is required and enforced.
ENVIRONMENT=development

# MongoDB connection string (required)
MONGODB_URI=

# MongoDB database name
AUTOXP_DB=autoxp

# JWT signing secret – must be 32+ random characters in production
JWT_SECRET=

# Comma-separated list of allowed frontend origins
# Example: https://autoxp.vercel.app,https://www.autoxp.com
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173

# Number of Uvicorn worker processes (default 1 for free-tier Docker hosts)
WEB_CONCURRENCY=1
